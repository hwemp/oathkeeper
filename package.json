{
  "name": "oathkeeper",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "npm run start --workspace=@oathkeeper/backend",
    "typecheck": "turbo run typecheck",
    "test": "npm run test --workspace=@oathkeeper/frontend"
  },
  "devDependencies": {
    "turbo": "^2.8.18"
  }
}
